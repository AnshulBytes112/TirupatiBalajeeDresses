# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR TIRUPATIBALAJEE DRESSES
# Supports Local Development, Supabase PostgreSQL, Vercel, and Render.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: Supabase Transaction Pooler URL (Port 6543) with ?pgbouncer=true
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection Pooling
# Example: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Supabase Direct Connection URL (Port 5432) for Prisma Schema Migrations
# Found in Supabase Dashboard -> Project Settings -> Database -> Direct Connection
# Example: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. APPLICATION & SECURITY
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT="3000"

# Set to your live production domain (e.g. https://your-project.vercel.app or https://tirupati-balaji.onrender.com)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="TirupatiBalajee Dresses"

# Generate a random 32+ character string (e.g. using `openssl rand -base64 32`)
NEXTAUTH_SECRET="your_secure_random_nextauth_secret_key_here_32_chars_min"

# Super-Admin authentication secret key (Used in Admin Headers & Operations)
SUPER_ADMIN_SECRET_KEY="super_admin_secret_tirupati_balaji_2026"
ADMIN_SECRET_KEY="super_admin_secret_tirupati_balaji_2026"
SUPER_ADMIN_PASSWORD="superadmin_tirupati_2026"

# ------------------------------------------------------------------------------
# 3. SUPABASE CLIENT & STORAGE (Optional / Supabase SDK)
# Found in Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"

# ------------------------------------------------------------------------------
# 5. LOGGING
# ------------------------------------------------------------------------------
LOG_LEVEL="info"
