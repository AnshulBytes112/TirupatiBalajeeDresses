# Environment Configuration for TirupatiBalajee Dresses
NODE_ENV="development"
PORT="3000"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="TirupatiBalajee Dresses"

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tirupati_balaji_dresses?schema=public"

# Authentication (NextAuth / Auth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="development_secret_key_change_in_production_min_32_chars_long"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_key_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"

# Storage (Cloudinary / S3)
CLOUDINARY_CLOUD_NAME="placeholder"
CLOUDINARY_API_KEY="placeholder"
CLOUDINARY_API_SECRET="placeholder"

# Cache & Rate Limiting (Redis)
REDIS_URL="redis://localhost:6379"

# Logging
LOG_LEVEL="debug"
